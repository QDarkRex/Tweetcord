# Tweetcord secrets — copy this file to ".env" and fill in the real values.
# NEVER commit .env or share it; it grants full control of the bot and the X account.

# Discord bot token: Developer Portal > your app > Bot > Reset Token
BOT_TOKEN=your_discord_bot_token_here

# X/Twitter login via burner accounts' auth_token cookies.
# Format: account_name:auth_token   (comma-separate multiple burners)
#   Single   -> TWITTER_TOKEN=burner1:aaaa
#   Multiple -> TWITTER_TOKEN=burner1:aaaa,burner2:bbbb,burner3:cccc
TWITTER_TOKEN=burner1:your_x_auth_token_here

# OPTIONAL — per-burner proxy. Leave unset/empty to disable (bot runs with no proxy).
# Routes each burner through its own proxy so multiple burners on one server IP
# aren't correlated / co-flagged by X. Format mirrors TWITTER_TOKEN:
#   account_name:proxy_url , comma-separated. Name must match TWITTER_TOKEN.
#   Schemes: http://, https://, socks5://
#   Example -> TWITTER_PROXY=burner1:socks5://user:pass@host1:1080,burner2:http://host2:3128
#TWITTER_PROXY=

# Where the bot stores its SQLite database (relative to the bot's working dir).
DATA_PATH=./data
